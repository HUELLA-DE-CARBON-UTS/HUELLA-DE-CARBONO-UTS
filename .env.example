# Aplicación
APP_NAME="Huella de Carbono UTS"
APP_ENV="development"
APP_DEBUG="True"
APP_PORT=8000

# Base de datos
DATABASE_URL="sqlite:///./dev.db"

# Seguridad
SECRET_KEY=""
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Administrador inicial (se usa mientras no exista el inicio de sesión, HU-06)
TOKEN_ADMIN_INICIAL="cambiar-este-token"
DOCUMENTO_ADMIN_INICIAL="1000000000"

# Servicio de correo (API-EXT-04). Si SMTP_HOST queda vacío, los correos
# se muestran en la consola del servidor (solo para desarrollo).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USUARIO=""
SMTP_CONTRASENA=""
CORREO_REMITENTE="no-responder@huella-carbono.local"
